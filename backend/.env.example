PORT=4000
NODE_ENV=development
# En production, une seule URL canonique partout (frontend, CORS, OAuth,
# sitemap, robots, OpenGraph) — actuellement lan2026.cegepstfe.ca dans
# index.html/sitemap.xml/robots.txt ; garder ALLOWED_ORIGINS/FRONTEND_URL/
# TICKET_URL alignés dessus, pas sur un autre sous-domaine.
ALLOWED_ORIGINS=http://localhost:5173,https://lan2026.cegepstfe.ca
TICKET_URL=https://lan2026.cegepstfe.ca/billetterie
FRONTEND_URL=http://localhost:5173

# Required in production — server refuses to boot without these (see config/secrets.js)
JWT_SECRET=change_me_to_a_long_random_string
SESSION_SECRET=change_me_to_a_different_long_random_string
ADMIN_PASSWORD=change_me

# Les adresses admin officielles ne sont JAMAIS stockées en clair, même ici —
# seule leur empreinte scrypt l'est. Pour générer un hash à partir d'une
# vraie adresse (à faire uniquement en local, jamais collée dans un commit) :
#   EMAIL_HASH_PEPPER=<meme_valeur_que_ci-dessous> node scripts/hash-email.js adresse@officielle.ca
# ADMIN_EMAIL_HASH = compte utilisé pour /api/auth/login (email+mot de passe)
# ADMIN_EMAILS_HASH = liste (séparée par virgules) d'empreintes autorisées à
#   obtenir le rôle admin via OAuth Google/Microsoft
# EMAIL_HASH_PEPPER DOIT être défini en production (le serveur refuse de
# démarrer sinon, voir config/secrets.js) et rester identique entre le calcul
# du hash et le serveur qui le vérifie — sinon plus aucune adresse ne matchera.
EMAIL_HASH_PEPPER=change_me_to_a_long_random_string
ADMIN_EMAIL_HASH=
ADMIN_EMAILS_HASH=

GEMINI_API_KEY=your_gemini_api_key_here

# Note: Stripe/Supabase donation secrets (STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SIGNING_SECRET, SUPABASE_SERVICE_ROLE_KEY) live in the
# Supabase project's Edge Function secrets, NOT here — this Express backend
# is not part of the donation pipeline. See supabase/functions/stripe-webhook/.

# SMTP (contact form, boutique orders, cagnotte) — leave unset to disable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_TO=comiteetuinfo@cegepstfe.ca

# Google OAuth — leave unset to disable the "Se connecter avec Google" button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Microsoft OAuth — leave unset to disable the "Se connecter avec Microsoft" button
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback
