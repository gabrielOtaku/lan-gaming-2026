PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,https://lan.cstfelicien.qc.ca
TICKET_URL=https://billetterie.cstfelicien.qc.ca/lan2026
FRONTEND_URL=http://localhost:5173

# Required in production — server refuses to boot without these (see config/secrets.js)
JWT_SECRET=change_me_to_a_long_random_string
SESSION_SECRET=change_me_to_a_different_long_random_string
ADMIN_PASSWORD=change_me

ADMIN_EMAIL=gabrielherve94@gmail.com
ADMIN_EMAILS=gabrielherve94@gmail.com,jovan.knezevic@cegepstfe.ca

GEMINI_API_KEY=your_gemini_api_key_here

# Note: Stripe/Supabase donation secrets (STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SIGNING_SECRET, SUPABASE_SERVICE_ROLE_KEY) live in the
# Supabase project's Edge Function secrets, NOT here — this Express backend
# is not part of the donation pipeline. See supabase/functions/stripe-webhook/.

# SMTP (contact form, boutique orders, cagnotte) — leave unset to disable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_TO=comiteetuinfo@cegepstfe.ca

# Google OAuth — leave unset to disable the "Se connecter avec Google" button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Microsoft OAuth — leave unset to disable the "Se connecter avec Microsoft" button
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback
