# Publishable/anon key only — RLS on the Supabase side protects the data.
# Never put a secret/service_role key here: everything prefixed VITE_ ships
# in the client bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Stripe Payment Link — swap for the live buy.stripe.com/... link before
# opening donations to the public (see the Supabase/Stripe/Twitch guide, §17).
VITE_STRIPE_DONATION_URL=https://buy.stripe.com/test_...
